# Where the SheltaMart API runs (sheltamart-v2-be).
# Read when the app is BUILT (the /api proxy is fixed at build time), so rebuild after changing it.
API_URL=http://localhost:4000

# Where the browser opens its live connection (notifications, messages). Usually the same host as API_URL,
# but it must be reachable from the browser (the public API address in production).
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
